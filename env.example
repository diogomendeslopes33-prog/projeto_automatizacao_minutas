# ============================================================
# IDENTIFICAÇÃO
# Coloca aqui o teu identificador institucional
# Futuramente substituído por token de autenticação Microsoft 365
# ============================================================
UTILIZADOR=nome.apelido

# ============================================================
# PASTAS DO PROJECTO
# Em regra não precisas de alterar estes valores
# ============================================================
PASTA_MINUTAS=minutas
PASTA_FORMULARIOS=formularios
PASTA_OUTPUT=output
PASTA_LOGS=logs

# ============================================================
# FICHEIRO A PROCESSAR
# Caminho relativo para o PDF do formulário a processar
# ============================================================
FICHEIRO_FORMULARIO=formularios/nome_do_formulario.pdf

# ============================================================
# CAMADA B — ENRIQUECIMENTO EMPRESARIAL
# MODO_EMPRESAS: "pdf" (extracção manual do site) ou "api" (APINFORMA)
# Enquanto não houver acesso à API, manter "pdf"
# PASTA_PDFS_EMPRESAS: pasta onde colocas os PDFs extraídos manualmente
# APINFORMA_API_KEY: deixar vazio até teres acesso contratado
# ============================================================
MODO_EMPRESAS=pdf
PASTA_PDFS_EMPRESAS=formularios/empresas
APINFORMA_API_KEY=

# ============================================================
# CAMADA C — ACUMULADOS ERP
# PASTA_ACUMULADOS_EMPRESA: PDFs "Documentos de um Fornecedor no
#   âmbito do CCP", um por NIF (ex: 505961989.PDF)
# PASTA_ACUMULADOS_CPV: Excel "Procura de Contratos - COMPRA", um
#   por código CPV (ex: 09123000.xlsx)
# PASTA_ACUMULADOS_OBJETOS: pasta por referência de procedimento,
#   com um Excel por termo de pesquisa dentro dela
#   (ex: acumulados_objetos/UA-ABS-Cpr-.../mobiliario.xlsx)
# Todas ficam vazias/sem ficheiro até exportares do ERP para o
# procedimento em causa — a ausência é tratada como "não
# verificado", nunca como acumulado zero
# ============================================================
PASTA_ACUMULADOS_EMPRESA=formularios/acumulados_empresa
PASTA_ACUMULADOS_CPV=formularios/acumulados_cpv
PASTA_ACUMULADOS_OBJETOS=formularios/acumulados_objetos